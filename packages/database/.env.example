# Read by drizzle.config.ts (via dotenv) for drizzle-kit commands run from this
# package: `pnpm --filter database generate|migrate|push|seed`.
#
# Use the DIRECT (session-mode) Neon endpoint here, not the pooled one — DDL
# cannot run through PgBouncer in transaction mode.
# Neon Console → your project → Connection Details → uncheck "Connection pooling".
DIRECT_DATABASE_URL=

# Used by the seed script, which goes through the normal runtime client.
# The POOLED endpoint (host contains `-pooler`).
DATABASE_URL=

# 1: ignore both URLs above and migrate / seed the local Postgres `pnpm db:local`
# runs (127.0.0.1:54329). Usually exported for one command instead:
#   NUTRIA_LOCAL_PG=1 pnpm --filter database migrate
NUTRIA_LOCAL_PG=
