{
  "name": "database",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./schema": {
      "types": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./schema/*": {
      "types": "./src/schemas/*.schema.ts",
      "default": "./dist/schemas/*.schema.js"
    },
    "./seed/ingredients": {
      "types": "./src/seed/ingredients/index.ts",
      "default": "./dist/seed/ingredients/index.js"
    }
  },
  "scripts": {
    "backup": "tsx ./scripts/backup.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check 'src/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts'",
    "generate": "drizzle-kit generate",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "migrate": "drizzle-kit migrate",
    "pull": "drizzle-kit pull",
    "push": "drizzle-kit push",
    "seed": "tsx ./src/seed/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-istanbul": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.2",
    "eslint-configuration": "workspace:*",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript-configuration": "workspace:*",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist"
  ]
}
