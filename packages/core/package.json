{
  "name": "core",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./controllers/*": {
      "types": "./src/controllers/*/index.ts",
      "default": "./dist/controllers/*/index.js"
    },
    "./domain/*": {
      "types": "./src/domain/*/index.ts",
      "default": "./dist/domain/*/index.js"
    },
    "./entities/*": {
      "types": "./src/entities/*/index.ts",
      "default": "./dist/entities/*/index.js"
    }
  },
  "imports": {
    "#repositories/*": {
      "types": "./src/repositories/*/index.ts",
      "default": "./dist/repositories/*/index.js"
    },
    "#test/*": "./src/test/*.ts"
  },
  "scripts": {
    "deadcode": "knip --tags=-knipignore --production",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "ts:check": "tsc --noEmit",
    "format": "prettier --check 'src/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "database": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "eslint": "^9.39.2",
    "eslint-configuration": "workspace:*",
    "prettier": "^3.8.3",
    "typescript-configuration": "workspace:*",
    "vitest": "^4.1.7"
  },
  "files": [
    "dist"
  ]
}
