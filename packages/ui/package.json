{
  "name": "ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./components/*": "./src/components/*/index.ts",
    "./fonts": "./src/fonts/index.ts",
    "./hooks/*": "./src/hooks/*/index.ts",
    "./styles/base": "./src/styles/base.css",
    "./styles/classnames": "./src/styles/classnames.css",
    "./styles/colors": "./src/styles/colors.css",
    "./styles/motion": "./src/styles/motion.css",
    "./styles/variables": "./src/styles/variables.css",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "generate:component": "turbo gen react-component",
    "generate:hook": "turbo gen hook",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "lint:cache": "pnpm lint --cache",
    "lint:ci": "pnpm lint:cache --cache-strategy content --quiet",
    "ts:check": "tsc --noEmit",
    "format": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-roving-focus": "^1.1.19",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "next": "^16.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@turbo/gen": "^2.11.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "eslint": "^9.39.2",
    "eslint-configuration": "workspace:*",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "typescript-configuration": "workspace:*",
    "vitest": "^4.1.11"
  }
}
