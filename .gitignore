# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files — covers .env, .env.local, .env.production, .env.<NODE_ENV>.local, etc.
# at any depth. The `!.env.example` negation lets the in-repo template files (one per
# consuming package + one per app — see apps/web/.env.example) stay visible.
.env*
!.env.example

# Local-only working docs — the ONLY uncommitted docs location. Session prompts,
# machine-specific context, strategy notes, half-formed ideas. Everything else in
# docs/ is meant to be committed. See AGENTS.md § Documentation.
docs/local/

# Testing
coverage

# Turbo
.turbo

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Build Outputs
.next/
# Anchored, because Next's static export only ever lands at an app root and a
# bare `out/` matches any directory of that name at any depth — which silently
# swallowed every `dto/out/` in apps/api. It compiled locally and could not
# compile from a fresh clone.
/out/
apps/*/out/
build
dist
dist-ssr
server/dist
public/dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# IDE
.idea/
.vscode/

# Agent tooling state — local to a machine, not to the project.
.serena/
.claude/.headroom_*

# Agent worktrees. Real checkouts of this repository living inside it — committing
# them would embed the repo in itself as an unfetchable gitlink.
.claude/worktrees/
:memory:*

# Knowledge graph output (graphify): 11 MB of generated artefacts, rebuilt on demand.
graphify-out/

# Database exports carry every user's health data; they never enter the repository.
backups/
