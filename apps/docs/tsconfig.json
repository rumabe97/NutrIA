{
  "extends": "typescript-configuration/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "components/*": ["./src/components/*"],
      "lib/*": ["./src/lib/*"],
      "styles/*": ["./src/styles/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", "next.config.js", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
