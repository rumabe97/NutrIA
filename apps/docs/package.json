{
  "name": "docs",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack --port 3002",
    "lint:cache": "pnpm lint --cache",
    "lint:ci": "pnpm lint:cache --cache-strategy content --quiet",
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx,js,jsx}' --fix",
    "start": "next start",
    "ts:check": "tsc --noEmit",
    "format": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx,css}'"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.3",
    "next": "^16.3.3",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.2",
    "eslint-configuration": "workspace:*",
    "prettier": "^3.9.8",
    "typescript-configuration": "workspace:*"
  }
}
