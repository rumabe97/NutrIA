{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]; then echo \"Skipping deployment for $VERCEL_GIT_COMMIT_REF\"; exit 0; fi; exit 1",
  "builds": [
    {
      "src": "vercel/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "memory": 1024
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "vercel/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/illustrate",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/v1/cron/rewrite-steps",
      "schedule": "*/5 * * * *"
    }
  ]
}
