# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
LOG_LEVEL=info

# ── URLs ─────────────────────────────────────────────────────────────────
# APP_URL is the Next.js frontend; BETTER_AUTH_URL is this API's public origin.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated. REQUIRED in production, and must not contain localhost —
# session cookies make CORS an authentication control, not a convenience.
ALLOWED_ORIGINS=http://localhost:3000
# The parent domain the session cookie is written for, leading dot included.
# Set it when the API and the web app are on sibling subdomains, which is the
# deployed shape: the web app reads this cookie itself, so a cookie scoped to
# the API's host alone leaves every protected page redirecting to sign-in.
# Leave empty for local development.
COOKIE_DOMAIN=

# ── Neon PostgreSQL (server-only — never expose these) ────────────────────
# DATABASE_URL: the POOLED endpoint (host contains `-pooler`). Used at runtime.
# DIRECT_DATABASE_URL: the DIRECT endpoint. Migrations only — DDL cannot run
# through PgBouncer in transaction mode.
# Neon Console → your project → Connection Details.
DATABASE_URL=
DIRECT_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# ── AI (server-only — an exposed key is a billable incident) ──────────────
# Which provider generates dishes. The engine reuses existing recipes before it
# generates anything, so most plans make no call at all — see
# docs/decisions/0006-reuse-before-generating.md.
#
#   stub      — no provider, no key, no spend. Plans are built purely from recipes
#               already in the library; generation fails honestly if that is not
#               enough. This is the default, and a valid way to run.
#   google    — free tier, no card. Key: aistudio.google.com/apikey
#               Model availability changes: a key issued today may not be able to
#               use an older model. Leave AI_MODEL empty and the default follows.
#               Check their terms on training from submitted data before sending
#               anything health-adjacent.
#   anthropic — paid. Key: console.anthropic.com (needs a card)
#   ollama    — a model on your own machine. No key; set AI_BASE_URL.
AI_PROVIDER=stub

# LEAVE THIS EMPTY unless you want a specific model. Empty means "the chosen
# provider's default": claude-sonnet-5, gemini-3.6-flash, or llama3.1.
#
# Model names are provider-specific, so a value left over from another provider
# is rejected at boot rather than failing on the first generation.
AI_MODEL=

# Only the key for the selected provider is required; the others may stay empty.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ollama only.
AI_BASE_URL=

# ── Email ────────────────────────────────────────────────────────────────
# Without SMTP configured, verification and reset links are written to the log
# so local development still works end to end.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Must be false in production — a published schema maps the attack surface.
SWAGGER_ENABLED=true
