{
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "rootDir": ".",
  "setupFilesAfterEnv": [
    "<rootDir>/setup-e2e.ts"
  ],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 120000,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/../tsconfig.json"
      }
    ]
  }
}
