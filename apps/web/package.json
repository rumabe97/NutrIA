{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack --port 3000",
    "lint:cache": "pnpm lint --cache",
    "lint:ci": "pnpm lint:cache --cache-strategy content --quiet",
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx,js,jsx}' --fix",
    "start": "next start",
    "ts:check": "tsc --noEmit",
    "format": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-auth": "^1.7.3",
    "core": "workspace:*",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "^4.1.7",
    "eslint": "^9.39.2",
    "eslint-configuration": "workspace:*",
    "prettier": "^3.8.3",
    "typescript-configuration": "workspace:*",
    "vitest": "^4.1.7"
  }
}
