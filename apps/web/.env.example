# ── Database (server-only) ────────────────────────────────────────────
# ADMIN_DATABASE_URL bypasses RLS (sign-up, cross-user lookups).
# RLS_DATABASE_URL respects it (owner-scoped reads/writes via database().rls()).
# Both: Supabase → Settings → Database → Connection string.
ADMIN_DATABASE_URL=
RLS_DATABASE_URL=

# ── Supabase (public — inlined into client bundles) ───────────────────
# Safe to expose; the publishable (anon) key is RLS-bound.
# ⚠️ Never put a SERVICE_ROLE key behind NEXT_PUBLIC_.
# Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
