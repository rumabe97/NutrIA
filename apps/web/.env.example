# The NestJS API's public origin.
#
# Everything here is public by construction. This app holds no database
# connection, no auth secret, no AI key and no payment key: every one of those
# lives in apps/api and never crosses the network to the browser. Payments in
# particular add nothing to this file — Checkout is opened by redirecting to a
# URL the API asks Stripe for, so no card details and no Stripe SDK ever reach
# the page (docs/reference/payments.md).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# This app's own public origin, used to build the canonical and hreflang links
# in every page's head. Not a secret — it is printed in the HTML. It has to be
# configurable because the production origin is a *.vercel.app host today and a
# real domain later, and a canonical link pointing at the wrong origin tells a
# search engine the page it just read is a copy of one somewhere else. Unset, it
# falls back to http://localhost:3000, which is right for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Where THIS SERVER reaches the API for server-rendered reads, and
# what `/api/v1/*` is proxied to in next.config.js. Set it when the API is on a
# host the browser must not talk to directly — two `*.vercel.app` hosts are
# different sites to a browser and no session cookie can span them. With it set,
# NEXT_PUBLIC_API_URL above becomes this app's own origin plus /api/v1, so the
# browser only ever talks to one host. Leave empty for local development.
API_UPSTREAM_URL=
