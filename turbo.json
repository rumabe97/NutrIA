{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AI_BASE_URL",
    "AI_ILLUSTRATIONS",
    "AI_MODEL",
    "AI_PROVIDER",
    "AI_REQUESTS_PER_DAY",
    "AI_TOKENS_PER_MINUTE",
    "AI_REWRITE_STEPS",
    "ALLOWED_ORIGINS",
    "ANTHROPIC_API_KEY",
    "API_PREFIX",
    "API_UPSTREAM_URL",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "COOKIE_DOMAIN",
    "CRON_SECRET",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "EMAIL_FROM",
    "GOOGLE_API_KEY",
    "LOG_LEVEL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NODE_ENV",
    "OWNER_EMAIL",
    "PORT",
    "RATE_LIMIT_MAX",
    "RATE_LIMIT_TTL",
    "SENTRY_DSN",
    "SMTP_HOST",
    "SMTP_PASS",
    "SMTP_PORT",
    "SMTP_USER",
    "SWAGGER_ENABLED",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix"
      ],
      "cache": false
    },
    "format": {
      "dependsOn": [
        "^format"
      ],
      "cache": false
    },
    "format:fix": {
      "dependsOn": [
        "^format:fix"
      ],
      "cache": false
    },
    "ts:check": {
      "dependsOn": [
        "^build",
        "^ts:check"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^test:coverage"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
